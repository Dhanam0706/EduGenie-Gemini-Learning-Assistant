# Copy this file to ".env" and put your own key in it.
# Get a key at https://aistudio.google.com/ (Google AI Studio).
# Never commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the Gemini model (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
